'use client';
import { useState, useEffect } from 'react';
import { useSearchParams } from 'next/navigation';
import { supabase } from '@/lib/supabase';

export default function MenuPage() {
  const searchParams = useSearchParams();
  const tableNumber = searchParams.get('table') || '1'; // ดึงเลขโต๊ะจาก URL

  const [menus, setMenus] = useState([]);
  const [cart, setCart] = useState([]);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    fetchMenus();
  }, []);

  async function fetchMenus() {
    const { data } = await supabase.from('menus').select('*').eq('is_available', true);
    setMenus(data || []);
  }

  const addToCart = (menu) => {
    setCart((prev) => {
      const existing = prev.find((item) => item.id === menu.id);
      if (existing) {
        return prev.map((item) =>
          item.id === menu.id ? { ...item, quantity: item.quantity + 1 } : item
        );
      }
      return [...prev, { ...menu, quantity: 1 }];
    });
  };

  const totalPrice = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

  const submitOrder = async () => {
    if (cart.length === 0) return alert('กรุณาเลือกอาหารก่อนสั่งครับ');
    setLoading(true);

    // 1. สร้าง Order
    const { data: order, error } = await supabase
      .from('orders')
      .insert([{ table_number: parseInt(tableNumber), total_price: totalPrice }])
      .select()
      .single();

    if (error) {
      alert('เกิดข้อผิดพลาดในการสั่งอาหาร');
      setLoading(false);
      return;
    }

    // 2. สร้าง Order Items
    const orderItems = cart.map((item) => ({
      order_id: order.id,
      menu_id: item.id,
      quantity: item.quantity,
      price: item.price,
    }));

    await supabase.from('order_items').insert(orderItems);

    setLoading(false);
    setCart([]);
    alert(`ส่งออเดอร์เรียบร้อยแล้วสำหรับโต๊ะ ${tableNumber}!`);
  };

  return (
    <div className="max-w-md mx-auto p-4 pb-24 font-sans">
      <h1 className="text-2xl font-bold mb-1">สั่งอาหาร - โต๊ะ {tableNumber}</h1>
      <p className="text-gray-500 mb-6 text-sm">เลือกรายการอาหารที่คุณต้องการสั่ง</p>

      <div className="space-y-4">
        {menus.map((menu) => (
          <div key={menu.id} className="flex justify-between items-center p-3 border rounded-lg shadow-sm">
            <div>
              <h3 className="font-semibold">{menu.name}</h3>
              <p className="text-gray-600">฿{menu.price}</p>
            </div>
            <button
              onClick={() => addToCart(menu)}
              className="bg-emerald-600 text-white px-3 py-1.5 rounded-md text-sm hover:bg-emerald-700"
            >
              + เพิ่ม
            </button>
          </div>
        ))}
      </div>

      {/* แถบสรุปราคาด้านล่าง */}
      {cart.length > 0 && (
        <div className="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white border-t p-4 shadow-lg">
          <div className="flex justify-between mb-2">
            <span className="font-semibold">รวมทั้งหมด ({cart.reduce((a, b) => a + b.quantity, 0)} รายการ):</span>
            <span className="font-bold text-emerald-600">฿{totalPrice}</span>
          </div>
          <button
            onClick={submitOrder}
            disabled={loading}
            className="w-full bg-emerald-600 text-white py-3 rounded-lg font-bold hover:bg-emerald-700 disabled:opacity-50"
          >
            {loading ? 'กำลังส่งออเดอร์...' : 'ยืนยันสั่งอาหาร'}
          </button>
        </div>
      )}
    </div>
  );
}
